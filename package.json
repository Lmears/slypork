{
  "type": "module",
  "devDependencies": {
    "esbuild": "0.28.2",
    "meshoptimizer": "1.3.0",
    "tailwindcss": "^4.3.3",
    "three": "0.186.1"
  },
  "scripts": {
    "build:pig-lods": "node scripts/build-pig-lods.mjs",
    "build:three": "node scripts/build-three.mjs",
    "build:css": "tailwindcss -i assets/css/input.css -o assets/css/output.css --minify",
    "watch:css": "tailwindcss -i assets/css/input.css -o assets/css/output.css --minify --watch",
    "check:security": "python3 scripts/check-security.py",
    "start": "python3 -m http.server 8080 --bind 127.0.0.1"
  }
}
